{
  "name": "yashfit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:vitest": "vitest run",
    "test:legacy": "jiti tests/autopilot.test.ts && jiti tests/virtualGym.test.ts && jiti tests/megaUpgrades.test.ts && jiti tests/megaUpgrades2.test.ts && jiti tests/megaUpgrades3.test.ts && jiti tests/megaUpgrades4.test.ts && jiti tests/megaUpgrades5.test.ts && jiti tests/megaUpgrades6.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop-chrome",
    "test": "npm run typecheck && npm run test:vitest && npm run test:legacy"
  },
  "imports": {
    "@/*": "./src/*"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.50.0",
    "@types/three": "^0.186.0",
    "lucide-react": "^0.511.0",
    "next": "^16.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
