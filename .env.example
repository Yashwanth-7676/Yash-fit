# ==============================================================================
# YashFit Environment Variables Template (Development & Local Testing)
# Copy this file to `.env.local` for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Infrastructure (Required for Live Auth & Cloud Database)
# ------------------------------------------------------------------------------
# In local development without Supabase, YashFit automatically falls back to
# deterministic Local Demo Mode with zero configuration.
# To connect your own Supabase project:
# - Create a project at https://supabase.com
# - Obtain these credentials from Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-actual-anon-key-here

# ------------------------------------------------------------------------------
# 2. Application Domain & URLs
# ------------------------------------------------------------------------------
# Canonical URL for SEO sitemaps, robots.txt, metadata, and auth redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. AI Providers (Optional - YashFit includes deterministic rule-based fallbacks)
# ------------------------------------------------------------------------------
# Provider choice: 'gemini' | 'openai' | 'rule-based' (default: 'gemini' if key present)
AI_PROVIDER=gemini

# Google Gemini API Key for AI Virtual Coach, Astra Companion & Food Vision
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API Key (Alternative/Secondary LLM provider)
# Obtain from OpenAI Platform: https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key-here

# ------------------------------------------------------------------------------
# 4. Monitoring & Telemetry (Optional)
# ------------------------------------------------------------------------------
# NODE_ENV is automatically set by Next.js ('development' | 'production' | 'test')
# Sentry / Datadog DSN if error tracking is enabled
# NEXT_PUBLIC_SENTRY_DSN=

