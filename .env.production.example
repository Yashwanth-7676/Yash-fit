# ==============================================================================
# YashFit Production Environment Variables Template
# Set these in your hosting provider's dashboard (e.g., Vercel Project Settings > Environment Variables)
# DO NOT COMMIT ACTUAL PRODUCTION SECRETS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Production Infrastructure (REQUIRED for live production)
# ------------------------------------------------------------------------------
# Set to your dedicated production Supabase project URL (must start with https://)
NEXT_PUBLIC_SUPABASE_URL=https://prod-project-id.supabase.co

# Set to your production Supabase anon/public key (Project Settings > API > Project API Keys > anon)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Canonical Production Domain & SSL (REQUIRED)
# ------------------------------------------------------------------------------
# Your custom production domain with HTTPS
NEXT_PUBLIC_APP_URL=https://yashfit.app

# ------------------------------------------------------------------------------
# 3. Production AI Intelligence Providers (RECOMMENDED)
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=your-production-gemini-key

# Optional OpenAI fallback
OPENAI_API_KEY=your-production-openai-key

# ------------------------------------------------------------------------------
# 4. Production Node Environment
# ------------------------------------------------------------------------------
NODE_ENV=production

